NODE_ENV=development
PORT=4000

# Origin of the frontend (used by CORS)
CORS_ORIGIN=http://localhost:5173

# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# JSON "database" file and upload folder (relative to backend/)
DB_FILE=data/db.json
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# true = re-create the database from seed data on every start
RESET_DB=false

# Max login attempts per IP per 15 minutes
LOGIN_RATE_LIMIT=20
